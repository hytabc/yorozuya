# 生产环境必须修改为随机长字符串,例如:openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret

# 首次启动时创建;数据库中已存在同名管理员后不会覆盖其密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NICKNAME=万事屋管理员

# 普通用户无法接取有密码委托时展示的群聊 ID
STAFF_GROUP_ID=123456789


WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080

# 数据库自动快照保留份数(每次写入后备份到 backend/data/backups/,只留最近 N 份)
DB_BACKUP_KEEP=100

# 启用 frpc 时填写(docker compose --profile tunnel up -d)
FRP_SERVER_ADDR=frps.example.com
FRP_SERVER_PORT=7000
FRP_TOKEN=replace-with-frps-token
FRP_REMOTE_PORT=18080

# ── 万事屋看板娘「小白」(站内 AI 助手,集中式大脑)──
# docker compose 只自动读取【项目根目录】的这一份 .env(backend/.env 不会被读取),
# 值会经 docker-compose.yml 的 environment 段传入后端容器。
# 不填 MASCOT_API_KEY 则聊天接口返回"未启用",站点其余功能不受影响。
# MASCOT_API_BASE = 云大脑网关地址(koishi-mascot 桥);MASCOT_API_KEY = 网关访问 token,
# 两值需与大脑侧 MASCOT_TOKEN 一致,否则大脑返回 403。
MASCOT_API_BASE=http://127.0.0.1:8200
MASCOT_API_KEY=
MASCOT_MODEL=kimi-k2.7-code-highspeed
MASCOT_MAX_TOKENS=1500
