# 生产环境必须修改为随机长字符串,例如:openssl rand -hex 32
# (未配置时后端会每次启动随机生成,重启后所有登录失效,且 Compose 会直接拒绝启动)
SECRET_KEY=replace-with-a-long-random-secret

# 首次启动时创建;数据库中已存在同名管理员后不会覆盖其密码
# (未配置时首次创建管理员会随机生成密码并打印到日志;若已有管理员仍用默认密码会被自动轮换)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NICKNAME=万事屋管理员

# ⚠️ 本文件会随仓库公开。真实域名、备案号等私有信息只能写进 .env(已被 .gitignore 忽略),
#    不要写进本示例文件或任何其它入库文件。
#
# ── HTTPS / Let's Encrypt ──
# 站点对外域名:edge 用它渲染 nginx server_name 并定位证书目录,务必与 DNS 解析一致。
DOMAIN=example.com
# 证书到期提醒邮箱(Let's Encrypt 要求;首次签发见 deploy/init-letsencrypt.sh)。
LETSENCRYPT_EMAIL=you@example.com
# 先用 staging 试签避免触发 Let's Encrypt 速率限制:签发时设 CERTBOT_STAGING=1 试跑,
# 确认无误后改为 0 重新签发正式证书。
CERTBOT_STAGING=0
# 浏览器同源访问,正常不触发 CORS;默认留空即可,需要跨域时再填写来源地址。
CORS_ORIGINS=

# ── 网站备案信息(页脚展示,可选)──
# 备案号原文,留空则页脚不展示。例如:京ICP备00000000号
SITE_ICP=
# 点击备案号跳转的地址,默认工信部备案查询系统;如另有公安备案可改这里。
SITE_ICP_URL=https://beian.miit.gov.cn/

# 仅开发覆盖文件(docker-compose.dev.yml)使用:本地 Vite 的宿主机端口。
WEB_PORT=8080

# 数据库自动快照保留份数(每次写入后备份到 backend/data/backups/,只留最近 N 份)
DB_BACKUP_KEEP=100

# ── 待审媒体(受控访问)──
# 待审/被屏蔽的图片存放在私有目录,不在 /uploads 静态托管范围内,
# 只能凭短时签名地址访问;审核通过后才会搬进公开上传目录。
# ⚠️ 该目录必须位于公开上传目录之外,否则待审图片仍会被 /uploads 直接下载(启动时会校验并报错)。
# 默认跟随数据目录,一般无需修改。
# MEDIA_PRIVATE_DIR=/data/private_media
# 私有媒体签名地址的有效期(秒,默认 6 小时)。越短,审核驳回后旧链接失效越快。
# MEDIA_TOKEN_TTL_SECONDS=21600

# ── 虚拟人生内容包(存档校验)──
# 存档按 backend/app/life_packs/*.json 中声明的内容包校验;LIFE_PACK_ID 指定站点活动包。
# 新增/更换内容包时,前端 frontend/src/life/content/ 需有同名 Pack,两边 id 必须一致。
LIFE_PACK_ID=wsw-default-life

# ── 万事屋看板娘「小白」(站内 AI 助手,集中式大脑)──
# docker compose 只自动读取【项目根目录】的这一份 .env(backend/.env 不会被读取),
# 值会经 docker-compose.yml 的 environment 段传入后端容器。
# 不填 MASCOT_API_KEY 则聊天接口返回"未启用",站点其余功能不受影响。
# MASCOT_API_BASE = 云大脑网关地址(koishi-mascot 桥);MASCOT_API_KEY = 网关访问 token,
# 两值需与大脑侧 MASCOT_TOKEN 一致,否则大脑返回 403。
MASCOT_API_BASE=http://127.0.0.1:8200
MASCOT_API_KEY=
MASCOT_MODEL=kimi-k2.7-code-highspeed
MASCOT_MAX_TOKENS=1500

# ── 登录/注册人机验证 ──
# CAPTCHA_ENABLED=false 可整体关闭(不推荐生产环境关闭)。
CAPTCHA_ENABLED=true
# turnstile=Cloudflare Turnstile(推荐);builtin=站内图形验证码
CAPTCHA_PROVIDER=turnstile
# Turnstile 公开 Site Key(可入库)
TURNSTILE_SITE_KEY=0x4AAAAAAEwPP7x-AwVA_SVE
# ⚠️ 从 Cloudflare 后台复制的 Secret Key,只能放服务端,必须填写,
# 否则服务端校验会返回 invalid-input-secret,登录/注册永远无法通过。
# 本地开发可用官方测试密钥(恒定通过):1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
