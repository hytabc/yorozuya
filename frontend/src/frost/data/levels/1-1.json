  ],
  "fragments": [
    {
      "id": "frag_1_1_01",
      "levelId": "1-1",
      "type": "gray",
      "character": "Mio",
      "text": "澪把现实同学群的聚会邀请静音，关掉了房间的灯。",
      "tags": ["anchor", "reality", "withdraw"],
      "draggable": false,
      "valence": -1,
      "note": "固定起点。现实中的落单，是澪登入的动因。"
    },
    {
      "id": "frag_1_1_02",
      "levelId": "1-1",
      "type": "white",
      "character": "Mio",
      "text": "她戴上头显，指尖在「进入」与「退出」之间停了很久。",
      "tags": ["hesitation"],
      "draggable": true,
      "valence": 0,
      "note": "犹豫。放在最前 = 先鼓起勇气按下进入；放在中间 = 世界已经展开，她仍被卡在门口。"
    },
    {
      "id": "frag_1_1_03",
      "levelId": "1-1",
      "type": "white",
      "character": "Narrator",
      "text": "公共 World 的加载条走完，湛蓝的天空在眼前铺开，身边是陌生人的笑声。",
      "tags": ["world", "overwhelm"],
      "draggable": true,
      "valence": 0,
      "note": "世界展开。它本身中性——是先看见，还是被邀请之后再看见，决定了它的意义。"
    },
    {
      "id": "frag_1_1_04",
      "levelId": "1-1",
      "type": "white",
      "character": "Shiori",
      "text": "一个橙色头像的老玩家转过身来，朝她挥了挥手：「新手？跟着我，别走丢啦。」",
      "tags": ["invitation", "reach_out"],
      "draggable": true,
      "valence": 1,
      "note": "邀请。本关的关键因果轴：它出现在'看见世界'之前还是之后。"
    },
    {
      "id": "frag_1_1_05",
      "levelId": "1-1",
      "type": "white",
      "character": "Mio",
      "text": "澪犹豫了三秒，也抬起手，和对方的手掌轻轻碰了一下。",
      "tags": ["choice", "accept"],
      "draggable": true,
      "valence": 2,
      "note": "回应。必须紧邻邀请才能成立。"
    },
    {
      "id": "frag_1_1_06",
      "levelId": "1-1",
      "type": "gray",
      "character": "Narrator",
      "text": "系统提示：「Shiori 成为了你的第一位好友。」",
      "tags": ["anchor", "bond"],
      "draggable": false,
      "valence": 1,
      "note": "固定终点。无论中间怎么排，结果都是'成为好友'——差别在于这个结果的分量。"
    }
  ],
  "endings": [
    {
      "id": "1_1_good",
      "levelId": "1-1",
      "type": "good",
      "title": "第一次握手",
      "threshold": 70,
      "valence": 1,
      "constraints": [
        { "kind": "position", "frag": "frag_1_1_02", "index": 1, "weight": 25 },
        { "kind": "before", "a": "frag_1_1_02", "b": "frag_1_1_03", "weight": 15 },
        { "kind": "before", "a": "frag_1_1_03", "b": "frag_1_1_04", "weight": 25 },
        { "kind": "adjacent", "a": "frag_1_1_04", "b": "frag_1_1_05", "weight": 35 }
      ],
      "anti": [
        { "kind": "before", "a": "frag_1_1_03", "b": "frag_1_1_02", "weight": 30 }
      ],
      "text": "她戴上头显，指尖在「进入」与「退出」之间停了很久，最后按下了「进入」。加载完成的时候，天空已经铺开。一个橙色头像的老玩家先转过身来，朝她挥了挥手。澪犹豫了三秒，也抬起手，和对方轻轻碰了一下。\n\n——原来位置，真的是可以自己找的。",
      "excerpt": "先鼓起勇气，再被接住。",
      "bondEffect": { "Mio": 10, "Shiori": 5 }
    },
    {
      "id": "1_1_bittersweet",
      "levelId": "1-1",
      "type": "bittersweet",
      "title": "平行线",
      "threshold": 60,
      "valence": 0,
      "constraints": [
        { "kind": "position", "frag": "frag_1_1_04", "index": 1, "weight": 30 },
        { "kind": "before", "a": "frag_1_1_04", "b": "frag_1_1_03", "weight": 25 },
        { "kind": "before", "a": "frag_1_1_03", "b": "frag_1_1_02", "weight": 25 },
        { "kind": "position", "frag": "frag_1_1_05", "index": 4, "weight": 20 }
      ],
      "anti": [
        { "kind": "before", "a": "frag_1_1_03", "b": "frag_1_1_04", "weight": 30 }
      ],
      "text": "老玩家先转过身来，朝她挥了挥手。天空是在这之后才慢慢铺开的，澪的指尖还停在「进入」与「退出」之间。等她终于抬起手回应时，对方已经等了很久。\n\n她们成了好友，一起逛了很多地方，可澪总觉得自己是跟着走的那个，连那天的天空是什么颜色都想不起来。",
      "excerpt": "被拉进来的人，记不住风景。",
      "bondEffect": { "Mio": 0, "Shiori": 3 }
    },
    {
      "id": "1_1_bad",
      "levelId": "1-1",
      "type": "bad",
      "title": "离线",
      "threshold": 55,
      "valence": -1,
      "constraints": [
        { "kind": "position", "frag": "frag_1_1_02", "index": 1, "weight": 25 },
        { "kind": "before", "a": "frag_1_1_05", "b": "frag_1_1_03", "weight": 25 },
        { "kind": "before", "a": "frag_1_1_05", "b": "frag_1_1_04", "weight": 25 },
        { "kind": "position", "frag": "frag_1_1_03", "index": 3, "weight": 25 }
      ],
      "anti": [
        { "kind": "adjacent", "a": "frag_1_1_04", "b": "frag_1_1_05", "weight": 20 }
      ],
      "text": "她戴上头显，指尖在「进入」与「退出」之间停了很久。澪先抬起了手，可身边什么都没有。天空铺开的时候，她站在陌生的广场中央，看着别人的名字一对对亮起来。\n\n等那只橙色的手终于朝她挥来，她已经把头显摘了下来。\n\n后来系统提示：「Shiori 成为了你的第一位好友。」澪看着那行字，没有点开。",
      "excerpt": "伸手的时候，对面还没有人。",
      "bondEffect": { "Mio": -10 }
    }
  ],
  "chaosEnding": {
    "id": "1_1_chaos",
    "levelId": "1-1",
    "type": "chaos",
    "title": "因果未能稳定",
    "threshold": 999,
    "valence": 0,
    "constraints": [],
    "anti": [],
    "text": "因果未能稳定……这段记忆还缺少一个开始。\n\n把碎片再排一次吧——重点不是「发生了什么」，而是「先发生了什么」。",
    "excerpt": "因果链还缺少一个开始。"
  },
  "hints": [
    {
      "tier": 1,
      "text": "注意澪的「回应」——它只有紧挨着老玩家那一下挥手，才算数。"
    },
    {
      "tier": 2,
      "text": "先让澪自己按下「进入」，再让世界展开，最后才被邀请。",
      "highlight": ["frag_1_1_02", "frag_1_1_04"]
    },
    {
      "tier": 3,
      "text": "推荐顺序：她戴上头显 → 天空铺开 → 老玩家挥手 → 澪回应。",
      "highlight": ["frag_1_1_02", "frag_1_1_03", "frag_1_1_04", "frag_1_1_05"]
    }
  ],
  "behindTheScenes": "1-1 想表达的是：VRChat 里的第一次接触，往往不是「认识了谁」，而是「终于有人先开口」。所以最优解的权重压在「先伸手」上——但更重要的是，玩家要先让澪自己鼓起勇气。「被邀请」和「被接住」是两件事。"
}
