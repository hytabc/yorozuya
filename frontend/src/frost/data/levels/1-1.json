  "fragments": [
    {
      "id": "frag_1_1_01",
      "levelId": "1-1",
      "type": "gray",
      "character": "Mio",
      "text": "澪把现实同学群的聚会邀请静音，关掉了房间的灯。",
      "tags": ["anchor", "reality", "withdraw"],
      "draggable": false,
      "valence": -1,
      "note": "固定起点。现实中的落单，是澪登入的动因。"
    },
    {
      "id": "frag_1_1_02",
      "levelId": "1-1",
      "type": "white",
      "character": "Mio",
      "text": "她戴上头显，指尖在「进入」上停了很久。",
      "tags": ["hesitation"],
      "draggable": true,
      "valence": 0,
      "note": "犹豫。放在最前 = 先鼓起勇气；放在中间 = 被推着进去。"
    },
    {
      "id": "frag_1_1_03",
      "levelId": "1-1",
      "type": "white",
      "character": "Narrator",
      "text": "湛蓝的虚拟天空在眼前铺开，身后是陌生人的笑声。",
      "tags": ["world", "overwhelm"],
      "draggable": true,
      "valence": 0,
      "note": "世界展开。它本身中性——是'先看见'还是'被邀请之后再看见'，决定了它的意义。"
    },
    {
      "id": "frag_1_1_04",
      "levelId": "1-1",
      "type": "white",
      "character": "Shiori",
      "text": "一个橙色头像的女孩伸出手：「新手？跟着我，别走丢啦。」",
      "tags": ["invitation", "reach_out"],
      "draggable": true,
      "valence": 1,
      "note": "邀请。本关的关键因果轴：它出现在'看见世界'之前还是之后。"
    },
    {
      "id": "frag_1_1_05",
      "levelId": "1-1",
      "type": "white",
      "character": "Mio",
      "text": "澪犹豫了三秒，握住了那只手。",
      "tags": ["choice", "accept"],
      "draggable": true,
      "valence": 2,
      "note": "接受。必须紧邻邀请才能成立。"
    },
    {
      "id": "frag_1_1_06",
      "levelId": "1-1",
      "type": "gray",
      "character": "Narrator",
      "text": "系统提示：「Shiori 成为了你的第一位好友。」",
      "tags": ["anchor", "bond"],
      "draggable": false,
      "valence": 1,
      "note": "固定终点。无论中间怎么排，结果都是'成为好友'——差别在于这个结果的分量。"
    }
  ],
