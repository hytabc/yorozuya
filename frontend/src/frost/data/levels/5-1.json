  "fragments": [
    {
      "id": "frag_5_1_01",
      "levelId": "5-1",
      "type": "gray",
      "character": "Mio",
      "text": "组队频道里，两人聊到一半，周围的人还在说笑。",
      "tags": ["anchor", "start"],
      "draggable": false,
      "valence": 0,
      "note": "固定起点。"
    },
    {
      "id": "frag_5_1_02",
      "levelId": "5-1",
      "type": "white",
      "character": "Mio",
      "text": "澪在频道里随口吐槽了一句：「这个 Avatar 看着有点怪。」",
      "tags": ["remark"],
      "draggable": true,
      "valence": -1,
      "note": "随口的一句。它本身不是恶意，但会被别人放大。"
    },
    {
      "id": "frag_5_1_03",
      "levelId": "5-1",
      "type": "white",
      "character": "Narrator",
      "text": "有人截了图，配上一句「这种话很过分」，转进了好几个群。",
      "tags": ["pile_on"],
      "draggable": true,
      "valence": -2,
      "note": "截图转述。它把一句话从语境里抽了出来。"
    },
    {
      "id": "frag_5_1_04",
      "levelId": "5-1",
      "type": "white",
      "character": "Mio",
      "text": "澪想解释，却发现对方已经把她屏蔽了，连私聊都发不出去。",
      "tags": ["blocked"],
      "draggable": true,
      "valence": -1,
      "note": "屏蔽。解释的窗口被关上了。"
    },
    {
      "id": "frag_5_1_05",
      "levelId": "5-1",
      "type": "white",
      "character": "Shiori",
      "text": "栞看完截图，私聊澪：「你是不是没想到会被这样理解？」",
      "tags": ["understanding"],
      "draggable": true,
      "valence": 1,
      "note": "理解。它先于澪的解释，才能把她从自责里拉出来。"
    },
    {
      "id": "frag_5_1_06",
      "levelId": "5-1",
      "type": "white",
      "character": "Mio",
      "text": "澪把这几天的聊天记录翻了一遍，越看越觉得自己真的很糟。",
      "tags": ["self_doubt"],
      "draggable": true,
      "valence": -1,
      "note": "自我怀疑。它在理解之前出现，才会让理解显得珍贵。"
    },
    {
      "id": "frag_5_1_07",
      "levelId": "5-1",
      "type": "white",
      "character": "Mio",
      "text": "澪写了一封很长的解释，没有辩解，只说了当时真正的意思，托栞转了过去。",
      "tags": ["clarify"],
      "draggable": true,
      "valence": 2,
      "note": "澄清。它必须在屏蔽之后、紧挨终点时才是'说清楚了'。"
    },
    {
      "id": "frag_5_1_08",
      "levelId": "5-1",
      "type": "red",
      "character": "Mio",
      "text": "澪的第一反应是愤怒：「凭什么？我只是说了实话。」",
      "tags": ["anger", "defensive", "negative"],
      "draggable": true,
      "valence": -2,
      "note": "红色碎片（新增）。愤怒是正常反应，但它如果排在自我反思之前，就会变成防御墙。它越靠前，修复的可能性越低。"
    },
    {
      "id": "frag_5_1_09",
      "levelId": "5-1",
      "type": "gray",
      "character": "Narrator",
      "text": "过了几天，好友列表里那个名字的状态，终于有了新的变化。",
      "tags": ["anchor", "end"],
      "draggable": false,
      "valence": 1,
      "note": "固定终点。中性：它可以是解除屏蔽，也可以只是状态变了。"
    }
  ],
