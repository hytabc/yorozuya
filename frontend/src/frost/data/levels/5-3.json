      "title": "重新开放的同行",
      "threshold": 70,
      "valence": 1,
      "constraints": [
        { "kind": "before", "a": "frag_5_3_02", "b": "frag_5_3_04", "weight": 20 },
        { "kind": "before", "a": "frag_5_3_04", "b": "frag_5_3_05", "weight": 20 },
        { "kind": "before", "a": "frag_5_3_05", "b": "frag_5_3_07", "weight": 20 },
        { "kind": "adjacent", "a": "frag_5_3_07", "b": "frag_5_3_08", "weight": 40 }
      ],
