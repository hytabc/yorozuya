  "fragments": [
    {
      "id": "frag_5_3_01",
      "levelId": "5-3",
      "type": "gray",
      "character": "Narrator",
      "text": "那段时间过去之后，两人的好友关系只剩下一个「已解除屏蔽」的标记。",
      "tags": ["anchor", "start"],
      "draggable": false,
      "valence": 0,
      "note": "固定起点。"
    },
    {
      "id": "frag_5_3_02",
      "levelId": "5-3",
      "type": "white",
      "character": "Shiori",
      "text": "栞发来一条私聊：「那天的事，我很抱歉。」",
      "tags": ["apology"],
      "draggable": true,
      "valence": 2,
      "note": "道歉。它是修复的起点。"
    },
    {
      "id": "frag_5_3_03",
      "levelId": "5-3",
      "type": "white",
      "character": "Mio",
      "text": "澪看着那句话，想了很久，还是没有回。",
      "tags": ["hesitation"],
      "draggable": true,
      "valence": -1,
      "note": "犹豫。它排在道歉之前，就是还没准备好；之后，就是还在想。"
    },
    {
      "id": "frag_5_3_04",
      "levelId": "5-3",
      "type": "white",
      "character": "Mio",
      "text": "澪说：「那天我也有我的问题。」",
      "tags": ["own_part"],
      "draggable": true,
      "valence": 2,
      "note": "承认自己的部分。它是对等的修复。"
    },
    {
      "id": "frag_5_3_05",
      "levelId": "5-3",
      "type": "white",
      "character": "Shiori",
      "text": "栞说：「我那时候太累了，没有好好解释。」",
      "tags": ["own_part_shiori"],
      "draggable": true,
      "valence": 1,
      "note": "栞承认自己的部分。它与澪的承认相互呼应。"
    },
    {
      "id": "frag_5_3_06",
      "levelId": "5-3",
      "type": "white",
      "character": "Narrator",
      "text": "两人在私聊里聊了很久，谁都没有提起截图和屏蔽。",
      "tags": ["talk"],
      "draggable": true,
      "valence": 1,
      "note": "坦然的对话。它把误会从'谁对谁错'拉到'我们怎么办'。"
    },
    {
      "id": "frag_5_3_07",
      "levelId": "5-3",
      "type": "white",
      "character": "Mio",
      "text": "澪回：「下次周三，要一起去吗？」",
      "tags": ["invite_back"],
      "draggable": true,
      "valence": 2,
      "note": "邀请回去。它必须紧跟在对等的承认之后。"
    },
    {
      "id": "frag_5_3_08",
      "levelId": "5-3",
      "type": "gray",
      "character": "Narrator",
      "text": "那个周三的晚上，两个名字又一次出现在了同一个 World 里。",
      "tags": ["anchor", "end"],
      "draggable": false,
      "valence": 1,
      "note": "固定终点。中性：同一个 World，可以是重逢，也可以是礼貌的同行。"
