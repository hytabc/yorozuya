      "title": "被拉进来",
      "threshold": 70,
      "valence": 1,
      "constraints": [
        { "kind": "before", "a": "frag_6_1_04", "b": "frag_6_1_06", "weight": 20 },
        { "kind": "before", "a": "frag_6_1_06", "b": "frag_6_1_08", "weight": 25 },
