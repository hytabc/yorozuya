  "hints": [
    {
      "tier": 1,
      "text": "关键在「栞开始找」和「澪躲起来」哪个在前。谁先动了？"
    },
    {
      "tier": 2,
      "text": "让栞先找、再私聊问、最后澪回答——回答之后必须紧挨着结尾。",
      "highlight": ["frag_1_2_04", "frag_1_2_05", "frag_1_2_06"]
