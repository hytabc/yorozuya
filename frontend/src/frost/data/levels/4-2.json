        { "kind": "before", "a": "frag_4_2_05", "b": "frag_4_2_06", "weight": 25 },
        { "kind": "adjacent", "a": "frag_4_2_06", "b": "frag_4_2_08", "weight": 30 }
      ],
      "anti": [
        { "kind": "adjacent", "a": "frag_4_2_07", "b": "frag_4_2_05", "weight": 40 }
