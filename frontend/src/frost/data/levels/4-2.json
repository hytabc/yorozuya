  "hints": [
    {
      "tier": 1,
      "text": "金色碎片决定的是顺序：先「被看见」，还是先「继续等」。"
    },
    {
      "tier": 2,
      "text": "让「这是你做的吗」和「嗯」紧挨着收尾，但不要让金色碎片贴在它们旁边——那会走向另一个结局。",
      "highlight": ["frag_4_2_05", "frag_4_2_06", "frag_4_2_07"]
