  "fragments": [
    {
      "id": "frag_4_2_01",
      "levelId": "4-2",
      "type": "gray",
      "character": "Rin",
      "text": "凛花了三个月，把糖霜世界搭好，只发了链接给一个人。",
      "tags": ["anchor", "start"],
      "draggable": false,
      "valence": 0,
      "note": "固定起点。"
    },
    {
      "id": "frag_4_2_02",
      "levelId": "4-2",
      "type": "white",
      "character": "Rin",
      "text": "那个人没有来。好友列表里的名字，一直是灰的。",
      "tags": ["waiting"],
      "draggable": true,
      "valence": -2,
      "note": "凛的核心伤口。它排得越后，凛'转身'的可能性越大。"
    },
    {
      "id": "frag_4_2_03",
      "levelId": "4-2",
      "type": "white",
      "character": "Rin",
      "text": "凛没有删掉这个世界，只是把灯调得暗了一点。",
      "tags": ["keep"],
      "draggable": true,
      "valence": -1,
      "note": "保留但不抱希望。"
    },
    {
      "id": "frag_4_2_04",
      "levelId": "4-2",
      "type": "white",
      "character": "Rin",
      "text": "后来她把链接发给了一群陌生人。有人来过，又走了。",
      "tags": ["strangers"],
      "draggable": true,
      "valence": 0,
      "note": "把世界交出去的第一步。"
    },
    {
      "id": "frag_4_2_05",
      "levelId": "4-2",
      "type": "white",
      "character": "Rin",
      "text": "只有澪，在雪原上站了很久，问了一句：「这是你做的吗？」",
      "tags": ["echo_1_3", "seen"],
      "draggable": true,
      "valence": 2,
      "note": "回声自 1-3。这是全作最重要的一次呼应。"
    },
    {
      "id": "frag_4_2_06",
      "levelId": "4-2",
      "type": "white",
      "character": "Rin",
      "text": "凛说：「嗯。」那是她在这个世界里说过的最长的一句话。",
      "tags": ["longest_word"],
      "draggable": true,
      "valence": 1,
      "note": "与 1-3 的「嗯」同构。"
    },
    {
      "id": "frag_4_2_07",
      "levelId": "4-2",
      "type": "gold",
      "character": "Rin",
      "text": "【关键】交换「等待」与「被看见」的顺序。",
      "tags": ["swap", "key"],
      "draggable": true,
      "valence": 0,
      "note": "金色碎片。它决定凛是继续等待，还是终于转身。"
    },
    {
      "id": "frag_4_2_08",
      "levelId": "4-2",
      "type": "gray",
      "character": "Narrator",
      "text": "糖霜世界的那盏灯，在这一晚亮到了最后。",
      "tags": ["anchor", "end"],
      "draggable": false,
      "valence": 2,
      "note": "固定终点。中性偏暖——灯亮着，但为谁亮着，由玩家决定。"
    },
    {
      "id": "frag_4_2_09",
      "levelId": "4-2",
      "type": "blue",
      "character": "Rin",
      "text": "【凛的独白】我不是在等他。我是在等一个能把这盏灯接过去的人。",
      "tags": ["insight"],
      "draggable": false,
      "valence": 0,
      "hidden": true,
      "unlockedBy": "butterfly:4-2:A",
      "note": "蝴蝶效应奖励。"
    }
  ],
