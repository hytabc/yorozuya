        { "kind": "before", "a": "frag_5_2_06", "b": "frag_5_2_07", "weight": 25 },
        { "kind": "before", "a": "frag_5_2_04", "b": "frag_5_2_06", "weight": 25 },
        { "kind": "adjacent", "a": "frag_5_2_06", "b": "frag_5_2_07", "weight": 25 }
      ],
