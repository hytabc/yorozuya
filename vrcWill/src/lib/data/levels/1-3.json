  "fragments": [
    {
      "id": "frag_1_3_01",
      "levelId": "1-3",
      "type": "gray",
      "character": "Shiori",
      "text": "栞把澪介绍给圈子里的常客们。",
      "tags": ["anchor", "start"],
      "draggable": false,
      "valence": 0,
      "note": "固定起点。"
    },
    {
      "id": "frag_1_3_02",
      "levelId": "1-3",
      "type": "white",
      "character": "Rin",
      "text": "凛坐在角落，几乎不说话，只是在调一个 World 的灯光。",
      "tags": ["quiet"],
      "draggable": true,
      "valence": 0,
      "note": "凛的出场。她的沉默是中性的，意义由澪如何解读决定。"
    },
    {
      "id": "frag_1_3_03",
      "levelId": "1-3",
      "type": "white",
      "character": "Mio",
      "text": "澪试着搭话：「这个 World……是你做的吗？」",
      "tags": ["approach"],
      "draggable": true,
      "valence": 1,
      "note": "主动靠近。"
    },
    {
      "id": "frag_1_3_04",
      "levelId": "1-3",
      "type": "white",
      "character": "Rin",
      "text": "凛只是「嗯」了一声，然后继续敲键盘。",
      "tags": ["blunt", "response"],
      "draggable": true,
      "valence": 0,
      "note": "凛的回应。它是「别扭的善意」还是「冷淡」，取决于它前面有没有澪的提问。"
    },
    {
      "id": "frag_1_3_05",
      "levelId": "1-3",
      "type": "white",
      "character": "Mio",
      "text": "澪觉得自己被讨厌了，默默退到人群边缘。",
      "tags": ["withdraw", "misread"],
      "draggable": true,
      "valence": -1,
      "note": "误解的落点。它越早出现，误会越深。"
    },
    {
      "id": "frag_1_3_06",
      "levelId": "1-3",
      "type": "white",
      "character": "Shiori",
      "text": "栞悄悄说：「凛不是冷淡，她只是不知道怎么回应别人。」",
      "tags": ["context", "explain"],
      "draggable": true,
      "valence": 1,
      "note": "解药。必须在澪退缩之前出现才有效。"
    },
    {
      "id": "frag_1_3_07",
      "levelId": "1-3",
      "type": "white",
      "character": "Rin",
      "text": "凛把调试好的灯光调亮了一点，正好照亮澪站的那一角。",
      "tags": ["silent_kindness", "reveal"],
      "draggable": true,
      "valence": 2,
      "hidden": true,
      "unlockedBy": "ending:1-3:good",
      "note": "隐藏碎片：通关本关 good 结局后解锁。它是通往 true 结局的唯一钥匙。"
    },
    {
      "id": "frag_1_3_08",
      "levelId": "1-3",
      "type": "gray",
      "character": "Narrator",
      "text": "深夜，澪收到凛发来的 World 链接，附言只有四个字：「随便逛逛。」",
      "tags": ["anchor", "end", "invite"],
      "draggable": false,
      "valence": 2,
      "note": "固定终点。邀请始终会来——问题只是澪还愿不愿意点开。"
    }
  ],
  "endings": [
