{
  "name": "sugar-frost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "《糖霜世界 Sugar Frost》——基于 VRChat 社交主题的因果叙事解谜网页游戏",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "verify": "node tools/verify-levels.ts",
    "test": "node --test tests/*.test.ts",
    "test:watch": "node --test --watch tests/*.test.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
