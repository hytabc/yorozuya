# 公网入口（edge）：终止 TLS + 强制 HTTP 跳转 HTTPS，再把请求转给内网 frontend。
# 本文件是模板：容器启动时由 edge-entrypoint.sh 用 envsubst 只替换 ${DOMAIN}，
# nginx 自身的 $host / $remote_addr 等运行时变量不受影响。
# 主站上游固定使用 default 网络内的 yorozuya-web 别名；不能改回 frontend，
# 因为 edge 接入游戏网络后，两个项目都会自动注册 frontend 这个 DNS 名。

# 入口层兜底限流：后端还有按业务的细粒度限流，这里只防止单 IP 洪泛。
# 静态资源不计入，只对 /api/ 生效，避免正常的页面加载被误伤。
limit_req_zone $binary_remote_addr zone=edge_api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=edge_conn:10m;

# 访问日志刻意不记录查询串：/api/media/ 的短时签名（?exp=&sig=）本身就是访问控制凭证，
# 用 $request 会把它持久化进日志，等于留下一串可重放的私有媒体地址。
# $uri 是归一化后的路径，天然不含 query。
log_format yorozuya '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    # 显式声明 default_server：即便镜像默认配置被覆盖，未知 Host / 直连 IP 也一定落到这里，
    # 再被下面的 $host 判断拦成 421，而不是落到某个未受控的默认站点。
    listen 80 default_server;
    server_name ${DOMAIN};
    if ($host != "${DOMAIN}") { return 421; }
    server_tokens off;
    access_log /var/log/nginx/access.log yorozuya;

    # ACME webroot 挑战必须保持 HTTP 明文可达，不能跳转到这里。
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 其余明文请求一律跳转 HTTPS。
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};
    if ($host != "${DOMAIN}") { return 421; }
    server_tokens off;
    access_log /var/log/nginx/access.log yorozuya;

    ssl_certificate         /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # 显式固化 TLS 1.2 套件（TLS 1.3 套件由 nginx 固定，无需配置），
    # 避免依赖具体 OpenSSL 版本的编译默认值。
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    # OCSP 装订：客户端无需自行请求 CA 即可拿到吊销状态（也避免隐私泄露给 CA）。
    # 需要 resolver 才能取 OCSP 响应；Docker 内嵌 DNS 是 127.0.0.11。
    resolver 127.0.0.11 ipv6=off valid=300s;
    ssl_stapling on;
    ssl_stapling_verify on;

    # 刻意不加 includeSubDomains / preload：避免波及同域下其它子域且难以回退。
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 默认只允许较小的请求体，只有下面的上传入口放宽到 55m。
    client_max_body_size 1m;

    # 上传接口：放宽请求体并计入限流。
    location ~ ^/api/(?:users/me/(?:avatar|photos)|sugar/profile|friends/profile|stories|vr-maps|virtual-life) {
        client_max_body_size 55m;
        # 不缓冲请求体：否则每个并发上传的 55m 请求体都会先落进 /var/cache/nginx（内存盘），
        # 几十个并发就能把宿主内存吃满。关掉后请求体直接流式转发给后端。
        client_body_timeout 120s;
        proxy_request_buffering off;
        limit_req zone=edge_api burst=40 nodelay;
        limit_conn edge_conn 30;
        proxy_pass http://yorozuya-web:80;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    # 其余接口：单 IP 限速限连，防止撞库/刷接口。
    location /api/ {
        limit_req zone=edge_api burst=40 nodelay;
        limit_conn edge_conn 30;
        proxy_pass http://yorozuya-web:80;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://yorozuya-web:80;
        # 真实客户端 IP 由 edge 写入；frontend 用 real_ip 模块还原后透传给后端供限流使用。
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        limit_conn edge_conn 60;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}
